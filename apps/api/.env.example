# Salin menjadi .env (tidak ikut repo).
PORT=3000

# Postgres pengembangan = Supabase (pooler mode transaksi, port 6543).
# Skrip yang menulis/menghapus data hanya mau berjalan ke host *.supabase.com.
DATABASE_URL=postgresql://postgres.<ref>:<sandi>@<region>.pooler.supabase.com:6543/postgres

# Rahasia token — masing-masing minimal 32 karakter acak, BERBEDA satu sama lain:
#   bun -e 'console.log(require("crypto").randomBytes(36).toString("base64url"))'
JWT_RAHASIA=
SESI_RAHASIA=

# Kode membuka kantor baru (POST /auth/register). Kosongkan = registrasi ditutup.
KODE_REGISTRASI=

# true bila server di belakang Nginx (produksi): alamat klien untuk pembatas
# percobaan dibaca dari X-Real-IP. Biarkan false saat pengembangan.
PERCAYA_PROXY=false

# Gerbang kalender lapangan (aturan-usaha C4). true = diperiksa (bawaan bila
# tidak ditulis; WAJIB di VPS). false hanya di laptop pengembangan — server
# menolak menyala bila ada yang false sementara DATABASE_URL bukan *.supabase.com.
# Sesudah mengubahnya, nyalakan ulang `bun run dev` (--watch tidak memantau .env).
VALIDASI_JAM_KERJA=true
VALIDASI_HARI_KERJA=true
VALIDASI_LIBUR_KANTOR=true
