{
  "name": "@opennael/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cd ../.. && bun --watch --env-file=apps/api/.env apps/api/src/server.ts",
    "start": "bun src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "bun test",
    "tipe": "tsc -p tsconfig.tipe.json"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@opennael/contracts": "workspace:*",
    "@opennael/domain": "workspace:*",
    "@scalar/hono-api-reference": "^0.12.13",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "hono-rate-limiter": "^0.5.4",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11"
  },
  "exports": {
    "./tipe": {
      "types": "./tipe/app.d.ts"
    }
  }
}
